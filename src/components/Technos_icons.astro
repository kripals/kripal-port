---
interface Props {
  name: string;
}
const { name } = Astro.props;
---
<li class="group flex items-center gap-x-2 rounded-full border border-white/10 bg-white/5 py-1.5 pl-2 pr-3 text-sm text-white/90 transition hover:-translate-y-0.5 hover:border-white/25 hover:bg-white/10">
  <span class="flex size-6 shrink-0 items-center justify-center [&>svg]:size-5 transition group-hover:scale-110">
    <slot/>
  </span>
  {name}
</li>
