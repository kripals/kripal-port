---
import Technos_icons from "./Technos_icons.astro";
import Techno_icon from '../icons/Titles/Techno_icon.astro';
// Languages
import Html from '../icons/Technologies/Languages/Html.astro';
import Css from '../icons/Technologies/Languages/Css.astro';
import Js from '../icons/Technologies/Languages/Js.astro';
import Typescript from '../icons/Technologies/Languages/Typescript.astro';
import Python from '../icons/Technologies/Languages/Python.astro';
import Go from '../icons/Technologies/Languages/Go.astro';
import Php from '../icons/Technologies/Languages/Php.astro';
// Frameworks & libraries
import React from '../icons/Technologies/Frameworks_Libraries/React.astro';
import Angular from '../icons/Technologies/Frameworks_Libraries/Angular.astro';
import Vuejs from '../icons/Technologies/Frameworks_Libraries/Vuejs.astro';
import Tailwind from '../icons/Technologies/Frameworks_Libraries/Tailwind.astro';
import Bootstrap from '../icons/Technologies/Frameworks_Libraries/Bootstrap.astro';
import Django from '../icons/Technologies/Frameworks_Libraries/Django.astro';
import Fastapi from '../icons/Technologies/Frameworks_Libraries/Fastapi.astro';
import Flask from '../icons/Technologies/Frameworks_Libraries/Flask.astro';
import Node from '../icons/Technologies/Frameworks_Libraries/Node.astro';
import Laravel from '../icons/Technologies/Frameworks_Libraries/Laravel.astro';
import Codeigniter from '../icons/Technologies/Frameworks_Libraries/Codeigniter.astro';
// APIs & architecture
import RestApi from '../icons/Technologies/Stack/RestApi.astro';
import Microservice from '../icons/Technologies/Stack/Microservice.astro';
import Graphql from '../icons/Technologies/Stack/Graphql.astro';
// Cloud & DevOps
import Aws from '../icons/Technologies/Devops/Aws.astro';
import Azure from '../icons/Technologies/Devops/Azure.astro';
import Docker from '../icons/Technologies/Devops/Docker.astro';
import Openshift from '../icons/Technologies/Devops/Openshift.astro';
import Vmware from '../icons/Technologies/Stack/Vmware.astro';
import Linux from '../icons/Technologies/Additional_Tools/Linux.astro';
import Git from '../icons/Technologies/Devops/Git.astro';
import Githubactions from '../icons/Technologies/Devops/Githubactions.astro';
import GitCICD from '../icons/Technologies/Devops/Gitcicd.astro';
// Databases
import Mysql from '../icons/Technologies/Databases/Mysql.astro';
import Postgresql from '../icons/Technologies/Databases/Postgresql.astro';
import Mongo from '../icons/Technologies/Databases/Mongo.astro';
import Oracle from '../icons/Technologies/Databases/Oracle.astro';
import Mariadb from '../icons/Technologies/Databases/Mariadb.astro';
// Agile & tools
import Jira from '../icons/Technologies/Additional_Tools/Jira.astro';
import Confluence from '../icons/Technologies/Additional_Tools/Confluence.astro';
import Nagios from '../icons/Technologies/Stack/Nagios.astro';
import Pytest from '../icons/Technologies/Additional_Tools/Pytest.astro';
import Poetry from '../icons/Technologies/Additional_Tools/Poetry.astro';
import Uv from '../icons/Technologies/Additional_Tools/Uv.astro';
// Additional
import PowerBI from '../icons/Technologies/Bitool/Powerbi.astro';
import Tableau from '../icons/Technologies/Bitool/Tableau.astro';
import Wordpress from '../icons/Technologies/Additional_Tools/Wordpress.astro';
import Magento from '../icons/Technologies/Additional_Tools/Magento.astro';

const GROUPS = [
  {
    title: "Frontend",
    items: [
      { name: "React", icon: React },
      { name: "Angular", icon: Angular },
      { name: "Vue.js", icon: Vuejs },
      { name: "JavaScript (ES6+)", icon: Js },
      { name: "TypeScript", icon: Typescript },
      { name: "HTML5", icon: Html },
      { name: "CSS3", icon: Css },
      { name: "Tailwind CSS", icon: Tailwind },
      { name: "Bootstrap", icon: Bootstrap },
    ],
  },
  {
    title: "Backend",
    items: [
      { name: "Python", icon: Python },
      { name: "Django", icon: Django },
      { name: "FastAPI", icon: Fastapi },
      { name: "Flask", icon: Flask },
      { name: "Go (Golang)", icon: Go },
      { name: "Node.js", icon: Node },
      { name: "PHP", icon: Php },
      { name: "Laravel", icon: Laravel },
      { name: "CodeIgniter", icon: Codeigniter },
    ],
  },
  {
    title: "APIs & Architecture",
    items: [
      { name: "RESTful APIs", icon: RestApi },
      { name: "Microservices", icon: Microservice },
      { name: "GraphQL", icon: Graphql },
    ],
  },
  {
    title: "Cloud & DevOps",
    note: "AWS: EC2, S3, RDS, Lambda, CloudFormation",
    items: [
      { name: "AWS", icon: Aws },
      { name: "Azure", icon: Azure },
      { name: "Docker", icon: Docker },
      { name: "Red Hat OpenShift", icon: Openshift },
      { name: "VMware", icon: Vmware },
      { name: "Linux", icon: Linux },
      { name: "Git", icon: Git },
      { name: "GitHub Actions", icon: Githubactions },
      { name: "CI/CD Pipelines", icon: GitCICD },
    ],
  },
  {
    title: "Databases",
    items: [
      { name: "MySQL", icon: Mysql },
      { name: "PostgreSQL", icon: Postgresql },
      { name: "MongoDB", icon: Mongo },
      { name: "Oracle SQL", icon: Oracle },
      { name: "MariaDB", icon: Mariadb },
    ],
  },
  {
    title: "Agile & Tools",
    items: [
      { name: "Jira", icon: Jira },
      { name: "Confluence", icon: Confluence },
      { name: "Nagios", icon: Nagios },
      { name: "pytest", icon: Pytest },
      { name: "Poetry", icon: Poetry },
      { name: "uv", icon: Uv },
    ],
  },
  {
    title: "Additional",
    items: [
      { name: "Power BI", icon: PowerBI },
      { name: "Tableau", icon: Tableau },
      { name: "WordPress", icon: Wordpress },
      { name: "Magento 2", icon: Magento },
    ],
  },
];
---

<div class="flex flex-col items-center px-4">
  <h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4">
    <Techno_icon class="w-12 h-12" /> Technologies
  </h2>

  <div class="w-full columns-1 md:columns-2 lg:columns-3 gap-6">
    {GROUPS.map(({ title, items, note }) => (
      <section class="mb-6 break-inside-avoid rounded-2xl border border-white/10 bg-white/[0.03] p-5">
        <header class="mb-4 flex items-baseline justify-between gap-x-3">
          <h3 class="text-lg font-semibold text-white">{title}</h3>
          <span class="text-xs text-white/50">{items.length}</span>
        </header>
        <ul class="flex flex-wrap gap-2">
          {items.map(({ name, icon: Icon }) => (
            <Technos_icons name={name}><Icon /></Technos_icons>
          ))}
        </ul>
        {note && <p class="mt-4 text-xs text-white/60">{note}</p>}
      </section>
    ))}
  </div>
</div>
