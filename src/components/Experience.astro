---

<ol class="relative border-s border-white/10 ms-2">
  {EXPERIENCE.map(({ company, location, role, period, current, points }) => (
    <li class="mb-12 ms-6 last:mb-0">
      <span class:list={[
        "absolute -start-[7px] mt-2 size-3.5 rounded-full border border-neutral-900",
        current ? "bg-green-400" : "bg-blue-300",
      ]}></span>

      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-4">
        <h3 class="text-xl md:text-2xl font-bold text-white">{role}</h3>
        <time class="text-sm opacity-70 whitespace-nowrap">{period}</time>
      </div>
      <p class="text-blue-300 font-semibold mt-1">
        {company} <span class="text-white/60 font-normal">· {location}</span>
      </p>

      <ul class="mt-3 space-y-2 list-disc ps-5 opacity-90 text-pretty [&_strong]:text-white [&_strong]:font-semibold">
        {points.map((point) => <li set:html={point} />)}
      </ul>
    </li>
  ))}
</ol>
