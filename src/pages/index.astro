---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import Linkedin from '../icons/Social/Linkedin.astro'
import Github from '../icons/Social/Github.astro'
import Social_icons from '../components/Social_icons.astro'
import Gmail from '../icons/Social/Gmail.astro'
import Section from '../components/Section.astro';
import Section_tecno from '../components/Section_techno.astro';
import Technologies from '../components/Technologies.astro';
import Code from '../icons/Titles/Code.astro'
import Projects from '../components/Projects.astro'
import Certificates from '../components/Certificates.astro'
import About_me from '../components/About_me.astro'
import Cert_icon from '../icons/Titles/Cert_icon.astro'
import Me_icons from '../icons/Titles/Me_icon.astro'
import Section_about_me from '../components/Section_about_me.astro'
import Footer from '../components/Footer.astro'
import Discord from '../icons/Social/Discord.astro'
import Section_certificates from '../components/Section_certificates.astro';
import Experience from '../components/Experience.astro'
import Briefcase from '../icons/Titles/Briefcase.astro'
---

<Layout 
	title="Kripal Shrestha - Software Developer | Backend & Full Stack"
	description="Software Developer in Kitchener, Ontario with 10+ years of experience building backend services, REST APIs, and full stack web applications with Python, PHP, Go, and modern JavaScript frameworks.">
	
	<main class="px-4">
		<Section id="home">
			<img 
				class="rounded-full w-20 h-15 mb-4" 
				src="/images/profile.jpg" 
				alt="Kripal"
			/> 
			
			<h1 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flex-row flex-wrap items-center gap-x-5 pb-6 lg:pb-10">
				Hi, I'm Kripal
				<a href="https://www.linkedin.com/in/kripalsth" target="_blank" rel="noopener" class="flex items-center hover:scale-110 transition">
					<Badge>Software Developer @ Bell Canada</Badge>
				</a>
			</h1>

			<h2 class="text-xl lg:text-2xl opacity-80 text-pretty max-w-[700px]">
				<span class="text-blue-300">Software Developer | Backend &amp; Full Stack</span>
				<br>Based in Kitchener, Ontario. I have 10+ years of experience building backend services, REST APIs, and full stack web applications with Python, PHP, and modern JavaScript frameworks. I work across microservices, Docker, AWS, and OpenShift, taking features from design through deployment.
			</h2>
			
			<nav class="flex gap-x-5 mt-6 flex-wrap">
				<Social_icons href="https://www.linkedin.com/in/kripalsth">
					<Linkedin class="size-4 md:size-6"/>
					LinkedIn
				</Social_icons>
				<Social_icons href="https://github.com/kripals">
					<Github class="size-4 md:size-6"/>
					GitHub
				</Social_icons>
				<Social_icons href="mailto:kripalshtha@gmail.com">
					<Gmail class="size-4 md:size-6"/>
					kripalshtha@gmail.com
				</Social_icons>
				<Social_icons href="https://discord.com/users/222491467275436033">
					<Discord class="size-4 md:size-6"/>
					Discord
				</Social_icons>
			</nav>
		</Section>

		<Section id="experience">
			<div class="flex justify-center">
				<h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4"> <Briefcase class="size-8 "/>Experience </h2>
			</div>
			<Experience/>
		</Section>

		<Section_tecno id="technologies">
			<Technologies/>
		</Section_tecno>

		<Section id="projects">
			<div class="flex justify-center">
				<h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4"> <Code class="size-8 "/>Projects </h2>
			</div>
			<Projects/>
		</Section>
		
		<!-- <Section_certificates id="certificates">
			<div class="flex justify-center">
				<h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4"> <Cert_icon class="size-8 "/>Certificates </h2>
			</div>
			<Certificates/>
		</Section_certificates> -->
		
		<Section_about_me id="about_me">
			<div class="flex justify-center">
				<h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4"> <Me_icons class="size-8 "/>About Me </h2>
			</div>
			<About_me/>
		</Section_about_me>
		
		<Footer/>
	</main>
</Layout>